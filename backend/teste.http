################################
### LOGIN (rota pública)

### - Login sem preencher a senha (deve dar erro 400)
POST http://localhost:3000/login
Content-Type: application/json

{
    "email": "adalberto@gmail.com"
}

### - Login com e-mail que não existe (deve dar erro 404)
POST http://localhost:3000/login
Content-Type: application/json

{
    "email": "naoexiste@gmail.com",
    "senha": "123"
}

### - Login com senha errada (deve dar erro 401)
POST http://localhost:3000/login
Content-Type: application/json

{
    "email": "adalberto@gmail.com",
    "senha": "errada"
}

### - Fazer Login do usuário (armazena o token automaticamente - válido por 1,5 hora)
# @name loginReq
POST http://localhost:3000/login
Content-Type: application/json

{
    "email": "adalberto@gmail.com",
    "senha": "123"
}

################################
### ROTAS PRIVADAS - sem token (deve dar erro 401)

### - Listar usuários SEM token
GET http://localhost:3000/usuarios
Content-Type: application/json

################################
### USUÁRIO - rotas privadas (precisam do token)

### - Teste para Listar o Usuário
GET http://localhost:3000/usuarios
Content-Type: application/json
Authorization: {{loginReq.response.body.token}}

### - Teste para Consultar o Usuário
GET http://localhost:3000/usuario/1
Content-Type: application/json
Authorization: {{loginReq.response.body.token}}

### - Teste para Consultar o Usuário por nome
GET http://localhost:3000/usuario/buscar/Marcos
Content-Type: application/json
Authorization: {{loginReq.response.body.token}}

### - Teste para Atualizar o Usuário (senha e cpf são criptografados de novo)
PUT http://localhost:3000/usuario/3
Content-Type: application/json
Authorization: {{loginReq.response.body.token}}

{
    "nome": "Rodrigo",
    "email": "rodrigo@gmail.com",
    "senha": "456",
    "cpf": "55566677788",
    "telefone": "47900001111"
}

### - Teste para Excluir o Usuário
DELETE http://localhost:3000/usuario/3
Content-Type: application/json
Authorization: {{loginReq.response.body.token}}

################################
### PRODUTO - rotas privadas

### - Teste para Cadastrar o Produto
POST http://localhost:3000/produto
Content-Type: application/json
Authorization: {{loginReq.response.body.token}}

{
    "nome": "Nike",
    "categoria": "casual",
    "numero": 38,
    "quantidade": 20,
    "precoUnit": 699.99
}

### - Teste para Cadastrar o Produto
POST http://localhost:3000/produto
Content-Type: application/json
Authorization: {{loginReq.response.body.token}}

{
    "nome": "Ultraboost",
    "categoria": "corrida",
    "numero": 40,
    "quantidade": 40,
    "precoUnit": 999.99
}

### - Teste para Cadastrar o Produto
POST http://localhost:3000/produto
Content-Type: application/json
Authorization: {{loginReq.response.body.token}}

{
    "nome": "Old Skool Pro",
    "categoria": "skate",
    "numero": 40,
    "quantidade": 20,
    "precoUnit": 399.99
}

### - Teste para Listar o Produto
GET http://localhost:3000/produtos
Content-Type: application/json
Authorization: {{loginReq.response.body.token}}

### - Teste para Consultar o Produto
GET http://localhost:3000/produto/1
Content-Type: application/json
Authorization: {{loginReq.response.body.token}}

### - Teste para Consultar o Produto por nome
GET http://localhost:3000/produto/buscar/Nike
Content-Type: application/json
Authorization: {{loginReq.response.body.token}}

### - Teste para Excluir o Produto
DELETE http://localhost:3000/produto/4
Content-Type: application/json
Authorization: {{loginReq.response.body.token}}

### - Teste para Atualizar o Produto
PUT http://localhost:3000/produto/3
Content-Type: application/json
Authorization: {{loginReq.response.body.token}}

{
    "nome": "Adidas",
    "categoria": "superStar",
    "numero": 42,
    "quantidade": 10,
    "precoUnit": 550.00
}

